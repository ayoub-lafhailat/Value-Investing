@page
@model ValueInvestingDemo.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h1 class="h4 fw-semibold mb-3">Something went wrong</h1>
                <p class="text-muted">@(Model.ErrorMessage ?? "An unexpected error occurred while processing the request.")</p>
                <a asp-page="/Index" class="btn btn-primary rounded-3">Back to home</a>
            </div>
        </div>
    </div>
</div>
